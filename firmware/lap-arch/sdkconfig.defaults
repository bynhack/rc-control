# ESP32-C3 SuperMini; for an S3 SuperMini: idf.py set-target esp32s3
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# The SuperMini's USB-C is the chip's own USB serial: logs and lap events go there.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# 1 ms ticks: the decoder is polled every few ms.
CONFIG_FREERTOS_HZ=1000
