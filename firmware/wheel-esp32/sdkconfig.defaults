# Shared by both targets; per-target settings are in sdkconfig.defaults.<target>.
# The native USB port is the USB host, so the console must be on UART0 (the
# board's USB-to-UART port), not USB-Serial/JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# Fonts used by the status screen.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# 1 ms ticks so the CRSF sender can run every 4 ms.
CONFIG_FREERTOS_HZ=1000
