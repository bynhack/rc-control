# Waveshare ESP32-P4-WIFI6-Touch-LCD-7B; the board's own settings are in
# sdkconfig.defaults.esp32p4.
CONFIG_IDF_TARGET="esp32p4"
# The native USB port is the USB host, so the console must be on UART0 (the
# board's USB-to-UART port), not USB-Serial/JTAG.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# Montserrat: the Latin, digits and symbols behind the CJK fonts, which fall
# back to it at each size.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# 1 ms ticks so the CRSF sender can run every 4 ms.
CONFIG_FREERTOS_HZ=1000
